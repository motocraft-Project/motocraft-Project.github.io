# Server-only secrets. Never commit real values.
GROQ_API_KEY=
MOTOCRAFT_AI_ACCESS_CODE=

# Origins allowed to call the API.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://motocraft-project.github.io

# Use the local protected API with `npm run dev:local`.
NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8787

# Efficient Groq model routing.
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
